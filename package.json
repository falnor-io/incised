{
  "name": "orlune",
  "version": "0.1.0",
  "description": "React components that show what an AI agent did, who signed off, and whether the record was tampered with.",
  "keywords": [
    "react",
    "agents",
    "ai",
    "audit",
    "trace",
    "verification",
    "shadcn",
    "registry",
    "openui",
    "dashboard"
  ],
  "homepage": "https://github.com/falnor-io/orlune#readme",
  "bugs": {
    "url": "https://github.com/falnor-io/orlune/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falnor-io/orlune.git"
  },
  "author": "Falnor",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./openui": {
      "types": "./dist/openui/index.d.ts",
      "default": "./dist/openui/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "node scripts/make-sample.mjs",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "registry": "node scripts/build-registry.mjs",
    "gallery": "python3 scripts/capture-screenshots.py && node scripts/build-gallery.mjs",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "lint": "node scripts/lint.mjs",
    "lint:visual": "node scripts/lint-visual.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run check && npm run build && npm run smoke:pack && npm run smoke:next",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "smoke:next": "node scripts/next-smoke.mjs",
    "docs": "node scripts/build-docs.mjs"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@openuidev/react-lang": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openuidev/react-lang": "1.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
