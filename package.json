{
  "name": "orlune",
  "version": "0.0.0",
  "description": "React components for agents that put it in writing: workflow views and tamper-evident record views.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./openui": {
      "types": "./dist/openui/index.d.ts",
      "default": "./dist/openui/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "node scripts/make-sample.mjs",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "registry": "node scripts/build-registry.mjs",
    "gallery": "python3 scripts/capture-screenshots.py && node scripts/build-gallery.mjs",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "lint": "node scripts/lint.mjs",
    "lint:visual": "node scripts/lint-visual.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@openuidev/react-lang": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openuidev/react-lang": "1.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
