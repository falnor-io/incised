  "narrative": {
    "northStar": "The Auditor's Ledger",
    "overview": "Orlune looks like a record you would trust: neutral surfaces, exact numbers, and a rule written next to every verdict. It disappears into the host app, inheriting its shadcn tokens. Colour is reserved for state, and motion only explains real steps.",
    "keyCharacteristics": [
      "Inherits the host theme; light and dark follow the OS or data-theme.",
      "Flat and tonal: one hairline frame, tinted washes for groups, no shadows.",
      "Tabular, literal, system type.",
      "State colour is semantic only.",
      "Nothing animates on first paint; every drawing has a text equivalent."
    ],
    "rules": [
      {
        "name": "The Verdict-Only Colour Rule",
        "body": "Green, amber and red appear only where a rule or verifier produced that state.",
        "section": "colors"
      },
      {
        "name": "The Inherit-First Rule",
        "body": "Define a colour as a fallback behind the host's variable, never instead of it.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number uses tabular figures so columns and counters never shift.",
        "section": "typography"
      },
      {
        "name": "The Record-Id Rule",
        "body": "Only hashes and ids use monospace.",
        "section": "typography"
      },
      {
        "name": "The Flat-Frame Rule",
        "body": "One hairline per component. No shadows at rest or on hover, and no card inside a card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read the host's shadcn variables first and use the --ol-* fallbacks only when they are absent.",
      "Do show the rule and the number behind every verdict, in a sentence.",
      "Do animate only to explain a real step, and switch it off under prefers-reduced-motion."
    ],
    "donts": [
      "Don't nest a bordered card in a panel; group with a 4% wash.",
      "Don't use shadows, gradient text, glass or decorative colour.",
      "Don't mark state with a coloured side stripe.",
      "Don't use bounce or elastic easing.",
      "Don't animate width or height."
    ]
  }
